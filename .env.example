# Copy to .env (gitignored). Never commit real values.

# Campaign wallet = agent wallet (owner of the ERC-8004 identity).
# Export the private key from OKX Wallet and paste it ONLY into .env.
PRIVATE_KEY=0x...
# Required by the SDK; the key is held in memory only, so any value works.
WALLET_PASSWORD=change-me-strong-unique

NETWORK=bsc-testnet
AGENT_NAME=Nagi
A2A_BASE_URL=http://localhost:8010   # public https URL once tunnelled
ERC8183_SERVICE_PRICE=1000000000000000000   # 1 U (18 decimals)
MARKET_SYMBOL=BNBUSDT

